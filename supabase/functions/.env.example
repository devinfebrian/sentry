# Local development may omit SENTINEL_ALLOWED_ORIGINS and use localhost defaults.
# Hosted Edge Functions require an explicit comma-separated HTTPS origin allowlist.
# Wildcard (*) is rejected.
SENTINEL_ALLOWED_ORIGINS=https://app.example.com

# Hosted setup:
# supabase secrets set SENTINEL_ALLOWED_ORIGINS=... --project-ref ...

# The fraud-pattern agent's model, from Google AI Studio. Without it that agent's runs fail
# with a reason naming this variable; the deterministic rules are unaffected.
# Never expose this as a VITE_ variable — those are compiled into the browser bundle.
GEMINI_API_KEY=your-ai-studio-key

# Optional. Overrides the model without a redeploy; defaults to DEFAULT_GEMINI_MODEL in
# functions/analyze-upload/geminiModel.ts (gemini-3.6-flash).
# Note: the free tier reports `limit: 0` for the pro models, which is a tier exclusion
# rather than a temporary limit — retrying never clears it. Set this only to a model the
# project's own ListModels call shows it may actually invoke.
# GEMINI_MODEL=
